<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance Pro" Height="500" Width="400" Background="#F5F5F7">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock Text="Учет финансов" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="15" Padding="15" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Button Content="&lt;" HorizontalAlignment="Left" Width="30" Click="PrevMonth_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    <TextBlock x:Name="MonthLabel" Text="Январь" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="MonthTextTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Button Content="&gt;" HorizontalAlignment="Right" Width="30" Click="NextMonth_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20">
            <Canvas x:Name="ChartCanvas" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="300" Height="250">
                <Rectangle x:Name="IncomeBar" Fill="#4CAF50" Width="60" Height="0" Canvas.Bottom="40" Canvas.Left="50" RadiusX="5" RadiusY="5"/>
                <Rectangle x:Name="ExpenseBar" Fill="#F44336" Width="60" Height="0" Canvas.Bottom="40" Canvas.Left="190" RadiusX="5" RadiusY="5"/>

                <StackPanel Orientation="Horizontal" Canvas.Bottom="0" Canvas.Left="45">
                    <Ellipse Fill="#4CAF50" Width="10" Height="10" Margin="5"/>
                    <TextBlock Text="Доход" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Fill="#F44336" Width="10" Height="10" Margin="25,5,5,5"/>
                    <TextBlock Text="Расход" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Canvas>
        </Grid>
    </Grid>
</Window>