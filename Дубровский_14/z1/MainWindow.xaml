<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансовый менеджер" Height="500" Width="750">

    <Window.Resources>
        <ControlTemplate x:Key="ModernButton" TargetType="Button">
            <Border x:Name="border" Background="#2196F3" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Выбрать дату:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding FilterDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    <Button Content="Сбросить фильтр" Command="{Binding ResetFilterCommand}" 
                            Margin="10,0" Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Баланс:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:N2} руб.}" 
                               FontWeight="Bold" Margin="10,0" FontSize="18" Foreground="#2E7D32"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Command="{Binding AddCommand}" Content="ДОБАВИТЬ" Template="{StaticResource ModernButton}" Foreground="White" Margin="5"/>
                <Button Command="{Binding EditCommand}" Content="ИЗМЕНИТЬ" Width="100" Margin="5"/>
                <Button Command="{Binding DeleteCommand}" Content="УДАЛИТЬ" Width="100" Margin="5"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding TransactionsView}" 
                  SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  Margin="10"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>