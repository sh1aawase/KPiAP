<Window x:Class="FinanceApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance Manager"
        Height="640"
        Width="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="MainGrid" Margin="15">
        <Border Background="#EFEFEF" Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBox Text="{Binding LoginInput, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5" />
                <PasswordBox x:Name="PassBox" Height="34" Margin="0,5"/>
                <Button Content="ВОЙТИ" Click="Login_Click" Height="40" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <TabItem Header="Финансы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#FFF3CD" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Reminder}" Foreground="#856404" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <GroupBox Header="Новая операция" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,6,0"/>
                                <Button Content="Добавить" Command="{Binding AddTransactionCommand}" Width="110"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Администрирование">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <TextBox x:Name="AdminRemInput" Width="220" Margin="0,0,6,0"/>
                                <Button Content="Обновить напоминание"
                                        Command="{Binding SaveReminderCommand}"
                                        CommandParameter="{Binding ElementName=AdminRemInput, Path=Text}"
                                        Width="170"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Transactions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              x:Name="FinanceGrid"
                              CellEditEnding="DataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" Width="140"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#E3F2FD" Margin="0,10" Padding="12" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Баланс:" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:N2} ₽}" FontSize="22" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="Удалить"
                                Command="{Binding DeleteTransactionCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=FinanceGrid}"
                                Width="120"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Аналитика">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Button Content="&lt;" Width="35" HorizontalAlignment="Left" Click="PrevMonth_Click"/>
                            <TextBlock x:Name="MonthLabel"
                                       Text="{Binding CurrentMonth}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="MonthTextTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <Button Content="&gt;" Width="35" HorizontalAlignment="Right" Click="NextMonth_Click"/>
                        </Grid>
                    </Border>

                    <Canvas Grid.Row="1" x:Name="ChartCanvas" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Height="320">
                        <Rectangle x:Name="IncomeBar" Fill="#4CAF50" Width="90" Height="0" Canvas.Bottom="55" Canvas.Left="110" RadiusX="6" RadiusY="6"/>
                        <Rectangle x:Name="ExpenseBar" Fill="#F44336" Width="90" Height="0" Canvas.Bottom="55" Canvas.Left="300" RadiusX="6" RadiusY="6"/>

                        <TextBlock Text="Доход" Canvas.Bottom="25" Canvas.Left="130" FontWeight="SemiBold"/>
                        <TextBlock Text="Расход" Canvas.Bottom="25" Canvas.Left="315" FontWeight="SemiBold"/>
                    </Canvas>
                </Grid>
            </TabItem>

            <TabItem Header="Чат">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding ChatMessages}" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="1">
                        <Button Content="Отправить"
                                Click="Clear_Click"
                                Command="{Binding SendMessageCommand}"
                                CommandParameter="{Binding ElementName=ChatIn, Path=Text}"
                                Width="120"
                                DockPanel.Dock="Right"/>
                        <TextBox x:Name="ChatIn" Height="34" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>