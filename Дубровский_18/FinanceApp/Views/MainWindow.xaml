<Window x:Class="FinanceApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance Manager" Height="550" Width="850" Background="#FAFAFA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#2196F3" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="Управление финансами" Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" x:Name="FinanceGrid" Background="White"
                  CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,5,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#E3F2FD" Margin="0,15" Padding="15" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Баланс:" FontSize="16" VerticalAlignment="Center" Foreground="#555"/>
                <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:N2} ₽}" 
                           FontSize="22" FontWeight="Bold" Margin="10,0,0,0" Foreground="#1565C0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="➕ Добавить" Command="{Binding AddTransactionCommand}" Width="150" Height="40" Background="#4CAF50"/>
            <Button Content="🗑️ Удалить" Command="{Binding DeleteTransactionCommand}" 
                    CommandParameter="{Binding SelectedItem, ElementName=FinanceGrid}" 
                    Background="#EF5350" Width="150" Height="40" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>